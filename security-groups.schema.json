{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://felcloud.tn/ipo/security-groups.schema.json",
  "title": "Security groups",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "members",
    "groups",
    "public"
  ],
  "$defs": {
    "group": {
      "type": "string",
      "pattern": "^sg-[a-z]+$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "from",
        "proto",
        "why"
      ],
      "properties": {
        "network": {
          "enum": [
            "edge",
            "sandbox",
            "mgmt"
          ]
        },
        "from": {
          "type": "string",
          "pattern": "^(internet|sg-[a-z]+)$"
        },
        "proto": {
          "enum": [
            "tcp",
            "udp",
            "vrrp",
            "any"
          ]
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "why": {
          "type": "string",
          "minLength": 4
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "proto": {
                "enum": [
                  "tcp",
                  "udp"
                ]
              }
            }
          },
          "then": {
            "required": [
              "ports"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "proto": {
                "enum": [
                  "vrrp",
                  "any"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "ports"
              ]
            }
          }
        }
      ]
    }
  },
  "properties": {
    "members": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/group"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "enum": [
            "gw-a",
            "gw-b",
            "cp-1",
            "cp-2",
            "relay",
            "bastion"
          ]
        }
      }
    },
    "groups": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/group"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ingress"
        ],
        "properties": {
          "ingress": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/rule"
            }
          }
        }
      }
    },
    "public": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "floating_ip_ports"
      ],
      "properties": {
        "floating_ip_ports": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        }
      }
    },
    "ephemeral": {
      "description": "Groups whose ports come and go outside platform.yaml (no fixed address expected)",
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      },
      "uniqueItems": true
    }
  }
}
