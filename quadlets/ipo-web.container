# cp-1 and cp-2: one origin on :8000 for the dashboard, the API (/v1) and Grafana (/grafana/),
# so the browser needs no CORS and Grafana's login cookie works inside the dashboard's frames.
[Unit]
Description=IPO web front (dashboard, API and Grafana on one origin)
Wants=network-online.target ipo-control-plane.service
After=network-online.target ipo-control-plane.service

[Container]
ContainerName=ipo-web
Image=docker.io/library/caddy:2.11.4
AutoUpdate=registry
Network=host
Volume=%h/.config/ipo/web/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=%h/.local/share/ipo/dashboard:/srv/dashboard:ro
Volume=ipo-web.volume:/data
# The host's certificate from the platform CA; keep-groups keeps the ipo-pki group that reads it.
Volume=/etc/ipo/pki:/etc/ipo/pki:ro
GroupAdd=keep-groups
ReadOnly=true
NoNewPrivileges=true
DropCapability=all
# The image's caddy binary carries the file capability cap_net_bind_service. A binary whose file
# capabilities fall outside the bounding set cannot be executed at all (EPERM), so that one
# capability stays, although the port it serves needs none (found on the first real deploy).
AddCapability=NET_BIND_SERVICE
HealthCmd=wget -q -O /dev/null http://127.0.0.1:8002/healthz
HealthInterval=10s
HealthRetries=3
HealthStartPeriod=20s
HealthOnFailure=kill
Notify=healthy

[Service]
# A first start pulls the image (through the egress proxy on FelCloud) on a slow cloud disk.
TimeoutStartSec=600
Restart=always

[Install]
WantedBy=default.target
