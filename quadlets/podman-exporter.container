# Container metrics on every Podman host, on loopback for the local Alloy to scrape.
[Unit]
Description=Prometheus Podman exporter
Wants=network-online.target podman.socket
After=network-online.target podman.socket

[Container]
ContainerName=podman-exporter
Image=quay.io/navidys/prometheus-podman-exporter:v1.21.2
AutoUpdate=registry
Network=host
Volume=%t/podman/podman.sock:/run/podman/podman.sock:ro
Environment=CONTAINER_HOST=unix:///run/podman/podman.sock
Exec=--web.listen-address=127.0.0.1:9882 --collector.enhance-metrics
SecurityLabelDisable=true
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=default.target
