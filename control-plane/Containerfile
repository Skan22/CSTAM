# The control-plane image. Build from the repository root, which the code needs for
# platform.schema.json (ipo/config.py looks two directories above itself):
#   podman build -f control-plane/Containerfile -t registry.felcloud.tn/ipo/control-plane:dev .
FROM docker.io/library/python:3.12.14-slim-trixie AS build
COPY --from=ghcr.io/astral-sh/uv:0.12.6 /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app/control-plane
COPY control-plane/pyproject.toml control-plane/uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY control-plane/ipo ./ipo

FROM docker.io/library/python:3.12.14-slim-trixie
RUN useradd --system --uid 10001 --user-group --home-dir /app --no-create-home ipo
COPY --from=build /app/control-plane /app/control-plane
COPY platform.schema.json /app/platform.schema.json
WORKDIR /app/control-plane
ENV PATH=/app/control-plane/.venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
EXPOSE 8001
CMD ["python", "-m", "ipo.main"]
