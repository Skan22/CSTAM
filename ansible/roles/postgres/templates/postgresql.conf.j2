# Managed by Ansible (role postgres). The same file on the primary and the replica, so either
# can be promoted (playbooks/promote_replica.yml).
listen_addresses = '127.0.0.1,{{ ipo_mgmt_ip }}'
port = 5432
hba_file = '/etc/ipo/postgres/pg_hba.conf'
max_connections = {{ postgres_max_connections }}
shared_buffers = {{ postgres_shared_buffers }}
password_encryption = scram-sha-256

wal_level = replica
max_wal_senders = 5
max_replication_slots = 5
wal_keep_size = 1GB
hot_standby = on

log_destination = 'stderr'
log_line_prefix = '%m [%p] %q%u@%d '
log_min_duration_statement = 500ms
log_connections = on
