# Managed by Ansible (role observability). Every host's Alloy scrapes its own targets and pushes
# here by remote write; Prometheus itself only scrapes the stack on this host.
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    platform: ipo
    stack: {{ ipo_stack }}

rule_files:
  - /etc/prometheus/alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["127.0.0.1:9093"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]
  - job_name: alertmanager
    static_configs:
      - targets: ["127.0.0.1:9093"]
  - job_name: loki
    static_configs:
      - targets: ["127.0.0.1:3100"]
  - job_name: tempo
    static_configs:
      - targets: ["127.0.0.1:3200"]
  - job_name: grafana
    metrics_path: /grafana/metrics
    static_configs:
      - targets: ["127.0.0.1:3000"]
