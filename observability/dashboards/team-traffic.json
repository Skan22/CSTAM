{
  "uid": "team-traffic",
  "title": "IPO Team Traffic",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "ipo"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Requests by team, last 5 min",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (team) (ipo_team_requests_5m{team=~\"$team\"})",
          "refId": "A",
          "legendFormat": "{{team}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 2,
      "title": "Responses by class",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (class) (ipo_team_requests_5m{team=~\"$team\"})",
          "refId": "A",
          "legendFormat": "{{class}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 3,
      "title": "5xx responses",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(ipo_team_requests_5m{team=~\"$team\", class=\"5xx\"})",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "title": "Mean latency (ms)",
      "type": "stat",
      "targets": [
        {
          "expr": "avg(ipo_team_latency_ms_5m{team=~\"$team\"})",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "title": "Latency by team (ms)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "ipo_team_latency_ms_5m{team=~\"$team\"}",
          "refId": "A",
          "legendFormat": "{{team}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "team",
        "label": "Team",
        "type": "query",
        "multi": true,
        "includeAll": true,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(ipo_team_requests_5m, team)",
          "refId": "team"
        },
        "refresh": 2,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
}
