{
  "uid": "provisioning",
  "title": "IPO Provisioning",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "ipo"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Provision time p95 by path",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(ipo_provision_duration_seconds_bucket[10m])))",
          "refId": "A",
          "legendFormat": "{{path}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 2,
      "title": "Saga step time p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, step) (rate(ipo_saga_step_duration_seconds_bucket[10m])))",
          "refId": "A",
          "legendFormat": "{{step}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 3,
      "title": "Jobs by outcome",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (kind, outcome) (increase(ipo_saga_jobs_total[10m]))",
          "refId": "A",
          "legendFormat": "{{kind}} {{outcome}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "title": "API latency p95 by route",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(ipo_api_request_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    }
  ]
}
