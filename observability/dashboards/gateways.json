{
  "uid": "gateways",
  "title": "IPO Gateways",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": [
    "ipo"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Config version per gateway",
      "type": "timeseries",
      "targets": [
        {
          "expr": "ipo_config_live_version",
          "refId": "A",
          "legendFormat": "{{gateway}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 2,
      "title": "Agent config version",
      "type": "timeseries",
      "targets": [
        {
          "expr": "ipo_agent_config_version",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 3,
      "title": "Configs applied",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(ipo_agent_config_applied_total[5m])",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 4,
      "title": "Configs rejected by reason",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (reason) (increase(ipo_agent_config_rejected_total[5m]))",
          "refId": "A",
          "legendFormat": "{{reason}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 5,
      "title": "Rollbacks",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(ipo_agent_rollbacks_total[5m])",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 6,
      "title": "VRRP transitions",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(ipo_agent_vrrp_transitions_total[5m])",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 7,
      "title": "Gateways reporting MASTER (should be 1)",
      "type": "stat",
      "targets": [
        {
          "expr": "max(ipo_gateway_masters) or sum(ipo_agent_vrrp_master)",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 8,
      "title": "MASTER per agent",
      "type": "timeseries",
      "targets": [
        {
          "expr": "ipo_agent_vrrp_master",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 9,
      "title": "Split brains seen (1h)",
      "type": "stat",
      "targets": [
        {
          "expr": "increase(ipo_split_brain_total[1h])",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 10,
      "title": "Gateways reporting MASTER, control plane view",
      "type": "timeseries",
      "targets": [
        {
          "expr": "ipo_gateway_masters",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 11,
      "title": "Reload duration p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ipo_agent_reload_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      }
    }
  ],
  "templating": {
    "list": []
  }
}
